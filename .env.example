# Copy to .env and fill in. Two ways to run:

# --- Option A: your LiteLLM instance (no Anthropic credits needed) ---
# The key here is your LiteLLM VIRTUAL KEY (often starts sk-...), not an
# Anthropic key. The Anthropic SDK talks to LiteLLM's /v1/messages endpoint.
ANTHROPIC_BASE_URL=http://192.168.132.144:4000
ANTHROPIC_API_KEY=<your-litellm-virtual-key>

# LiteLLM names models per its own config — they may not match Anthropic's
# public IDs. Run `python check_setup.py` to list what yours serves, then set:
# PROSPECT_MODEL=claude-opus-4-8

# Optional: run the outreach-email draft on its own model (Spanish creative copy,
# distinct from the research pipeline). Unset to reuse PROSPECT_MODEL.
# PROSPECT_EMAIL_MODEL=vertex_ai/claude-sonnet-5

# Optional: draft the outreach email with DeepSeek instead of Anthropic. It uses
# its own key + endpoint (OpenAI-compatible), independent of LiteLLM above — so it
# keeps working when the proxy is down or over budget. Only the email stage moves;
# research/qualify/contact stay on ANTHROPIC_*. Unset EMAIL_PROVIDER to stay on Anthropic.
# EMAIL_PROVIDER=deepseek
# With a proxy set, drafts go to DeepSeek through LiteLLM first and fall back to
# the personal DEEPSEEK_API_KEY below only if that call fails. Set it empty to
# always use the personal key.
# DEEPSEEK_PROXY_MODEL=deepseek/deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Output language ---
# Language the agent writes its research output (discovery notes, research
# summaries, qualification verdicts) and outreach emails in. The default lives in
# prospector/config.py (OUTPUT_LANGUAGE, currently 'spanish'); override it here.
# OUTPUT_LANGUAGE=english

# --- Follow-ups ---
# Days after each email until the next follow-up is due (one entry per follow-up).
# A due company moves back to Outreach > To do as "follow-up due"; nothing is
# drafted or sent on its own. A reply stops it. Default 4,7; "off" disables it.
# FOLLOWUP_DAYS=4,7

# --- Option B: Anthropic API directly ---
# Leave ANTHROPIC_BASE_URL unset/commented, and use a real Anthropic key from
# https://console.anthropic.com -> Settings -> API Keys (requires credits).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail sender ---
# Send outreach from this verified Gmail "Send mail as" alias instead of the
# account address itself. Unset to send as the account.
# GMAIL_SEND_AS=hello@feina.dev

# --- Scheduled sends ---
# The Gmail API can't schedule a send, so "go out Monday at 10:00" is handed to
# the prospector-scheduler service, which sends it with this laptop closed.
# Both must be set or the dashboard hides the scheduling controls; the token has
# to match that service's own SCHEDULER_TOKEN. Reach it over Tailscale or a
# tunnel — it can send email as you.
# SCHEDULER_URL=http://100.x.y.z:8083
# SCHEDULER_TOKEN=
